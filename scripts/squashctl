#!/usr/bin/env bash
# Operator CLI for the Squash RMM control plane.
#
#   export SQUASH_SERVER=https://35-173-64-136.sslip.io
#   export SQUASH_KEY=$(cat ~/.squash/operator.key)
#
#   squashctl devices                     the enrolled fleet
#   squashctl map                         fleet joined to its EC2 instances
#   squashctl install                     # token + command for a brand-new machine
#   squashctl upgrade <device-id|host>    # replace the binary remotely, no token, no RDP
#   squashctl reinstall <device-id|host>  # recovery token, for a machine whose key is gone
#   squashctl revoke <device-id|host>
#   squashctl restore <device-id|host>
#   squashctl run <device-id|host> '<powershell>'
#   squashctl restart <device-id|host> [--in <seconds>] [--reason '<text>'] [--yes]
set -euo pipefail

SERVER="${SQUASH_SERVER:-}"
KEY="${SQUASH_KEY:-}"

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
[[ -n $SERVER ]] || die "set SQUASH_SERVER (e.g. https://35-173-64-136.sslip.io)"
[[ -n $KEY ]] || die "set SQUASH_KEY (your operator API key)"

# The operator key is a fleet-wide credential; never put it on the wire in clear.
if [[ $SERVER == http://* && ${SQUASH_ALLOW_PLAINTEXT:-0} != 1 ]]; then
  die "refusing to send the operator key over http. Use https, or set SQUASH_ALLOW_PLAINTEXT=1 for a local test server."
fi

api() {
  local method=$1 path=$2 body=${3:-}
  local args=(-sS -X "$method" -H "X-API-Key: $KEY")
  [[ -n $body ]] && args+=(-H 'Content-Type: application/json' -d "$body")
  curl "${args[@]}" "$SERVER$path"
}

# Accepts a device id or a hostname and returns the device id.
resolve() {
  local needle=$1
  api GET /api/devices | python3 -c '
import json, sys
needle = sys.argv[1].lower()
devices = json.load(sys.stdin)
for d in devices:
    if d["deviceId"].lower() == needle:
        print(d["deviceId"]); sys.exit(0)
matches = [d for d in devices if needle in d["hostname"].lower()]
if len(matches) == 1:
    print(matches[0]["deviceId"]); sys.exit(0)
if not matches:
    sys.exit("no device matches " + sys.argv[1])
sys.exit("ambiguous: " + ", ".join(d["hostname"] for d in matches))
' "$needle"
}

print_install_command() {
  local token=$1 label=$2
  cat <<EOF

$label

Run in an Administrator PowerShell on the endpoint:

  iwr $SERVER/install.ps1 -OutFile i.ps1
  .\\i.ps1 -Server $SERVER -Token $token

EOF
}

case "${1:-}" in
map)
  # Joins the fleet to its EC2 instances. A Windows hostname is not derived
  # from the instance id, so the only reliable link is asking each machine for
  # its own id from the instance metadata service.
  printf '%-22s %-21s %-16s %s\n' HOSTNAME "INSTANCE ID" "PUBLIC IP" "AWS NAME TAG"
  printf '%.0s-' {1..86}; printf '\n'
  # Collected up front rather than piped into the loop: the per-device command
  # below reads stdin itself and would otherwise swallow the remaining rows.
  rows=()
  while IFS= read -r line; do rows+=("$line"); done < <(api GET /api/devices | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    print(d["deviceId"], d["hostname"], sep="\t")')
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r device hostname <<<"$row"
    # Windows sends CRLF; the carriage return survives into the value and makes
    # the instance id silently unusable as an argument.
    instance=$(SQUASH_SERVER="$SERVER" SQUASH_KEY="$KEY" "$0" run "$device" \
      '(Invoke-RestMethod -Uri "http://169.254.169.254/latest/meta-data/instance-id" -TimeoutSec 5)' \
      2>/dev/null </dev/null | tail -1 | tr -d '\r[:space:]')
    if [[ $instance == i-* ]]; then
      details=$(aws ec2 describe-instances --instance-ids "$instance" \
        --region "${AWS_REGION:-us-east-1}" \
        --query 'Reservations[0].Instances[0].[PublicIpAddress,Tags[?Key==`Name`]|[0].Value]' \
        --output text 2>/dev/null || true)
      ip=$(printf '%s' "$details" | cut -f1)
      name=$(printf '%s' "$details" | cut -f2)
      [[ -n $ip ]] || ip="-"
      [[ -n $name ]] || name="-"
    else
      instance="(offline - could not ask)"; ip="-"; name="-"
    fi
    printf '%-22s %-21s %-16s %s\n' "$hostname" "$instance" "$ip" "$name"
  done
  ;;

devices)
  api GET /api/devices | python3 -c '
import json, sys
rows = json.load(sys.stdin)
if not rows: sys.exit("no devices enrolled")
print("%-22s %-34s %-7s %s" % ("HOSTNAME", "DEVICE ID", "ONLINE", "REVOKED"))
for d in rows:
    print("%-22s %-34s %-7s %s" % (d["hostname"], d["deviceId"], d["online"], d["revoked"]))'
  ;;

install)
  token=$(api POST /api/enrollment-tokens '{}' | python3 -c 'import json,sys;print(json.load(sys.stdin)["token"])')
  print_install_command "$token" "Enrollment token for a machine that has never enrolled. Single use, 1 hour."
  ;;

reinstall)
  [[ $# -ge 2 ]] || die "usage: squashctl reinstall <device-id|hostname>"
  device=$(resolve "$2")
  token=$(api POST /api/enrollment-tokens "{\"allowRebind\":true,\"deviceId\":\"$device\"}" \
    | python3 -c 'import json,sys
d=json.load(sys.stdin)
if "token" not in d: sys.exit(d.get("detail","could not mint recovery token"))
print(d["token"])')
  print_install_command "$token" "Recovery token for $2 ($device).
It replaces that machine's key and works on no other device.
Uninstall first with:  iwr $SERVER/uninstall.ps1 -OutFile u.ps1; .\\u.ps1"
  ;;

upgrade)
  # Reinstalls in place over the agent's own connection. The control plane
  # owns the script (POST /api/devices/{id}/upgrade); this waits for the
  # agent to come back on the new build.
  [[ $# -ge 2 ]] || die "usage: squashctl upgrade <device-id|hostname>"
  device=$(resolve "$2")
  job=$(api POST "/api/devices/$device/upgrade" '{}' | python3 -c 'import json,sys
d=json.load(sys.stdin)
if "jobId" not in d: sys.exit(d.get("detail","dispatch failed"))
print(d["jobId"])')
  api GET "/api/jobs/$job?waitMs=65000" | python3 -c '
import json, sys
r = json.load(sys.stdin)
print("dispatch:", r["state"], "-", (r["stdout"] or r["error"] or "").strip())
sys.exit(0 if r["state"] == "Completed" else 1)'
  # The agent stays online until the task fires, so "online" proves nothing.
  # What counts is a reconnect recorded after the request, judged on the
  # server's clock rather than this machine's.
  since=$(api GET "/api/jobs/$job" | python3 -c 'import json,sys;print(json.load(sys.stdin)["createdAt"])')
  printf 'waiting for the agent to come back'
  for _ in $(seq 1 36); do
    sleep 5; printf '.'
    back=$(api GET "/api/devices/$device/events?limit=20" | python3 -c '
import json,sys
since=float(sys.argv[1])
print(any(e["event"] in ("online","rebooted") and e["at"] > since for e in json.load(sys.stdin)))' "$since")
    [[ $back == True ]] && { printf ' back online\n'; exit 0; }
  done
  printf '\n'
  die "agent did not reconnect; check C:\\Windows\\Temp\\squash-install.log on the endpoint"
  ;;

revoke|restore)
  [[ $# -ge 2 ]] || die "usage: squashctl $1 <device-id|hostname>"
  device=$(resolve "$2")
  action=$([[ $1 == revoke ]] && echo revoke || echo unrevoke)
  api POST "/api/devices/$device/$action" '{}' | python3 -m json.tool
  ;;

run)
  [[ $# -ge 3 ]] || die "usage: squashctl run <device-id|hostname> '<powershell>'"
  device=$(resolve "$2")
  job=$(api POST "/api/devices/$device/jobs" \
    "$(python3 -c 'import json,sys;print(json.dumps({"script":sys.argv[1],"timeoutSeconds":60}))' "$3")" \
    | python3 -c 'import json,sys
d=json.load(sys.stdin)
if "jobId" not in d: sys.exit(d.get("detail","dispatch failed"))
print(d["jobId"])')
  api GET "/api/jobs/$job?waitMs=65000" | python3 -c '
import json, sys
r = json.load(sys.stdin)
print("state %s  exit %s  exec %sms  round-trip %sms"
      % (r["state"], r["exitCode"], r["durationMs"], r["roundTripMs"]))
print("-" * 60)
if r["stdout"]: print(r["stdout"], end="")
if r["stderr"]: print("STDERR:", r["stderr"], file=sys.stderr)
if r["error"]: print("ERROR:", r["error"], file=sys.stderr)
sys.exit(0 if r["state"] == "Completed" and r["exitCode"] == 0 else 1)'
  ;;

restart|reboot)
  [[ $# -ge 2 ]] || die "usage: squashctl restart <device-id|hostname> [--in <seconds>] [--reason '<text>'] [--yes]"
  device=$(resolve "$2")
  host=$(api GET /api/devices | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d["deviceId"] == sys.argv[1]:
        print(d["hostname"]); break
else:
    sys.exit("device vanished between lookup and restart")' "$device")

  delay=15
  reason="Restart requested from Squash RMM"
  confirmed=0
  shift 2
  while [[ $# -gt 0 ]]; do
    case $1 in
      --in)     [[ $# -ge 2 ]] || die "--in needs a number of seconds"; delay=$2; shift 2 ;;
      --reason) [[ $# -ge 2 ]] || die "--reason needs a message"; reason=$2; shift 2 ;;
      --yes|-y) confirmed=1; shift ;;
      *) die "unexpected argument: $1" ;;
    esac
  done

  # Typing the name is not ceremony: it makes it impossible to restart the
  # wrong machine by confirming out of habit after mistyping the target.
  if [[ $confirmed -ne 1 ]]; then
    [[ -t 0 ]] || die "no terminal to confirm at. Pass --yes if you mean it."
    printf 'Restart %s in %ss?\n' "$host" "$delay"
    printf 'It goes offline for about a minute, and anything unsaved on it is lost.\n'
    printf 'Type the device name to confirm: '
    read -r typed
    lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
    [[ $(lower "$typed") == "$(lower "$host")" ]] \
      || die "name did not match. Nothing was restarted."
  fi

  body=$(python3 -c '
import json, sys
try:
    delay = int(sys.argv[1])
except ValueError:
    sys.exit("--in must be a whole number of seconds, got %r" % sys.argv[1])
print(json.dumps({"delaySeconds": delay, "reason": sys.argv[2]}))' "$delay" "$reason")

  job=$(api POST "/api/devices/$device/restart" "$body" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "jobId" not in d:
    detail = d.get("detail", d)
    # FastAPI returns a list of field errors for a schema failure.
    if isinstance(detail, list):
        detail = "; ".join(e.get("msg", str(e)) for e in detail)
    sys.exit("restart refused: %s" % detail)
if d.get("deduplicated"):
    print("already requested; showing the original job", file=sys.stderr)
print(d["jobId"])')

  printf '%s will restart in %ss.\n' "$host" "$delay"
  # The machine reports back before it goes down; that acknowledgement is the
  # only evidence the restart was actually scheduled rather than just asked for.
  api GET "/api/jobs/$job?waitMs=40000" | python3 -c '
import json, sys
r = json.load(sys.stdin)
print("state %s  exit %s  round-trip %sms" % (r["state"], r["exitCode"], r["roundTripMs"]))
if r["stdout"]: print(r["stdout"], end="")
if r["stderr"]: print("STDERR:", r["stderr"], file=sys.stderr)
if r["error"]: print("ERROR:", r["error"], file=sys.stderr)
sys.exit(0 if r["state"] == "Completed" and r["exitCode"] == 0 else 1)'
  ;;

*)
  # Prints the header comment, whatever length it is, so adding a command
  # above is enough to document it.
  awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
  exit 1
  ;;
esac
