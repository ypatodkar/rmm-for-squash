#!/usr/bin/env bash
# Plants a real fault on an endpoint so the RMM has to find it.
#
# Faults are planted over AWS SSM, deliberately not through this RMM: the
# investigation has to discover the problem from evidence rather than being
# handed it. Each one is a service the machine genuinely needs, stopped the
# way it would stop on its own.
#
#   scripts/plant-fault status            what is currently broken
#   scripts/plant-fault printing          stop the print spooler
#   scripts/plant-fault clock             stop the Windows time service
#   scripts/plant-fault display           stop the themes service
#   scripts/plant-fault memory            start a process that eats 1.5 GB
#   scripts/plant-fault dns               point example.com at a dead address (hosts file)
#   scripts/plant-fault firewall          block one.one.one.one with an outbound rule
#   scripts/plant-fault reset             put everything back
#
#   SQUASH_EVAL_INSTANCE   EC2 instance id of the endpoint (default below)
set -euo pipefail

INSTANCE="${SQUASH_EVAL_INSTANCE:-i-04808f091a04182f2}"
REGION="${AWS_REGION:-us-east-1}"

die() { printf 'error: %s\n' "$1" >&2; exit 1; }

run_on_endpoint() {
  local script=$1
  local command_id
  command_id=$(aws ssm send-command --instance-ids "$INSTANCE" \
    --document-name AWS-RunPowerShellScript \
    --parameters "$(python3 -c 'import json,sys;print(json.dumps({"commands":[sys.argv[1]]}))' "$script")" \
    --region "$REGION" --query Command.CommandId --output text 2>/dev/null) \
    || die "could not reach instance $INSTANCE over SSM"

  local status=""
  for _ in $(seq 1 40); do
    status=$(aws ssm get-command-invocation --command-id "$command_id" \
      --instance-id "$INSTANCE" --region "$REGION" --query Status --output text 2>/dev/null || echo "")
    [[ -n $status && $status != InProgress ]] && break
    sleep 2
  done
  [[ $status == Success ]] || die "command on the endpoint ended as ${status:-unknown}"

  aws ssm get-command-invocation --command-id "$command_id" --instance-id "$INSTANCE" \
    --region "$REGION" --query StandardOutputContent --output text
}

SERVICES="Spooler W32Time Themes"

# Network faults are marked so reset removes exactly what was added, and they
# only ever touch these two names. Nothing here may affect the control plane
# or SSM, or the machine could not be reached to undo it.
DNS_TARGET="example.com"
DNS_MARKER="squash-demo"
FIREWALL_RULE="SquashDemoBlock"

show_status() {
  echo "Endpoint $INSTANCE"
  echo
  run_on_endpoint "Get-Service ${SERVICES// /,} | Select-Object Name,Status,StartType | Format-Table -AutoSize | Out-String;
'hosts-file demo entries: ' + @(Select-String -Path \$env:SystemRoot\\System32\\drivers\\etc\\hosts -Pattern '$DNS_MARKER' | ForEach-Object { \$_.Line }).Count;
'demo firewall rule: ' + [bool](Get-NetFirewallRule -Name $FIREWALL_RULE -ErrorAction SilentlyContinue)"
}

plant() {
  local service=$1 label=$2 ticket=$3
  echo "Stopping $service on $INSTANCE …"
  run_on_endpoint "Stop-Service $service -Force; (Get-Service $service).Status" | sed 's/^/  /'
  cat <<EOF

Planted: $label

Now open the dashboard, go to Investigations, choose this device and paste:

  $ticket

The investigation has not been told what is wrong. It will collect evidence,
propose a fix, and wait for you to approve it.
EOF
}

case "${1:-status}" in
status)
  show_status
  ;;
printing)
  plant Spooler "the print spooler is stopped" \
    "Nothing prints from this computer. Print jobs disappear from the queue."
  ;;
clock)
  plant W32Time "the Windows time service is stopped" \
    "The clock on this computer keeps drifting and meetings show at the wrong time."
  ;;
display)
  plant Themes "the themes service is stopped" \
    "The desktop looks wrong on this computer, fonts and window styling are broken."
  ;;
memory)
  # A copy of powershell.exe under an application-like name, holding a fixed
  # allocation. Running it under its own name matters: the target of a repair
  # must be something safe to stop, and "powershell" is neither identifiable
  # nor safe when the agent itself runs scripts through it.
  echo "Starting a memory-hungry process on $INSTANCE …"
  run_on_endpoint "\$hog = Join-Path \$env:TEMP 'ReportBuilder.exe';
Copy-Item \$env:SystemRoot\\System32\\WindowsPowerShell\\v1.0\\powershell.exe \$hog -Force;
Start-Process \$hog -WindowStyle Hidden -ArgumentList '-NoProfile','-Command','\$b = New-Object byte[] 1610612736; for (\$i = 0; \$i -lt \$b.Length; \$i += 4096) { \$b[\$i] = 1 }; Start-Sleep -Seconds 7200';
Start-Sleep -Seconds 12;
Get-Process ReportBuilder -ErrorAction SilentlyContinue | Select-Object Name,Id,@{N='MemoryMB';E={[int](\$_.WorkingSet64/1MB)}} | Format-Table -AutoSize | Out-String" | sed 's/^/  /'
  cat <<'EOF'

Planted: a process called ReportBuilder holding about 1.5 GB

Now open the dashboard, go to Investigations, choose this device and paste:

  This computer has become very slow and unresponsive since this morning.

The investigation has not been told what is wrong. It will collect evidence,
propose a fix, and wait for you to approve it.
EOF
  ;;
dns)
  echo "Pointing $DNS_TARGET at a dead address on $INSTANCE …"
  run_on_endpoint "\$hosts = Join-Path \$env:SystemRoot 'System32\\drivers\\etc\\hosts';
if (-not (Select-String -Path \$hosts -Pattern '$DNS_MARKER' -Quiet)) {
  Add-Content -Path \$hosts -Value '10.255.255.1 $DNS_TARGET # $DNS_MARKER' -Encoding ASCII
};
ipconfig /flushdns | Out-Null;
'hosts file now has: ' + (Select-String -Path \$hosts -Pattern '$DNS_MARKER').Line" | sed 's/^/  /'
  cat <<EOF

Planted: $DNS_TARGET resolves to 10.255.255.1 through a hosts-file entry,
while the DNS server still gives the right answer.

Ticket to paste:

  This computer can't open $DNS_TARGET. Other websites work fine.

Or from the terminal:

  (cd driver && ../.venv/bin/python diagnose.py <hostname> "This computer can't open $DNS_TARGET. Other websites work fine.")
EOF
  ;;
firewall)
  echo "Blocking one.one.one.one outbound on $INSTANCE …"
  run_on_endpoint "Remove-NetFirewallRule -Name $FIREWALL_RULE -ErrorAction SilentlyContinue;
New-NetFirewallRule -Name $FIREWALL_RULE -DisplayName 'Block one.one.one.one' -Direction Outbound -Action Block -RemoteAddress 1.1.1.1,1.0.0.1 -Profile Any | Out-Null;
'rule added: ' + (Get-NetFirewallRule -Name $FIREWALL_RULE).DisplayName" | sed 's/^/  /'
  cat <<'EOF'

Planted: an outbound firewall rule blocks 1.1.1.1 and 1.0.0.1. Name
resolution still works, so the break is after DNS.

Ticket to paste:

  This machine can't reach one.one.one.one, but the rest of the internet works.

Or from the terminal:

  (cd driver && ../.venv/bin/python diagnose.py <hostname> "This machine can't reach one.one.one.one, but the rest of the internet works.")
EOF
  ;;
reset)
  echo "Removing network faults on $INSTANCE …"
  run_on_endpoint "Remove-NetFirewallRule -Name $FIREWALL_RULE -ErrorAction SilentlyContinue;
\$hosts = Join-Path \$env:SystemRoot 'System32\\drivers\\etc\\hosts';
\$kept = @(Get-Content \$hosts | Where-Object { \$_ -notmatch '$DNS_MARKER' });
Set-Content -Path \$hosts -Value \$kept -Encoding ASCII;
ipconfig /flushdns | Out-Null;
'network faults removed'" | sed 's/^/  /'
  echo "Restoring services on $INSTANCE …"
  run_on_endpoint "Get-Process ReportBuilder -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue;
Remove-Item (Join-Path \$env:TEMP 'ReportBuilder.exe') -Force -ErrorAction SilentlyContinue;
foreach (\$s in '${SERVICES// /','}') { Start-Service \$s -ErrorAction SilentlyContinue };
Get-Service ${SERVICES// /,} | Select-Object Name,Status | Format-Table -AutoSize | Out-String" | sed 's/^/  /'
  ;;
*)
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
  ;;
esac
