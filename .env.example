# Dashboard/operator authentication. Generate separate random op_... values.
SQUASH_OPERATOR_KEYS=operator:op_dashboard_replace_me,ai-driver:op_driver_replace_me

# The AI worker's own operator identity. It must match the ai-driver entry above.
SQUASH_DRIVER_KEY=op_driver_replace_me
SQUASH_SELF_URL=http://127.0.0.1:5200

# Model configuration. Never commit the real key.
OPENAI_API_KEY=replace_me
SQUASH_MODEL_PROVIDER=openai
SQUASH_MODEL=gpt-4.1
